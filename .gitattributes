# 统一行尾，避免 Windows 用户提交 CRLF 导致脚本在 Linux 上出现
# `bad interpreter: /bin/bash^M` 一类的报错
* text=auto eol=lf

*.sh    text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
LICENSE text eol=lf

# 二进制与压缩包不做行尾转换
*.png   binary
*.jpg   binary
*.zip   binary

# 发布压缩包不进入源码归档
*.zip   export-ignore
.github export-ignore
